\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {FALI resolves a conditional change in a selected attention head's causal usefulness.} (a) The same candidate head $h$ is evaluated in an intact state $A$ and a prespecified perturbed state $B$. (b) The quantity to be explained is the cross-state change $\Delta _h=E_B(h)-E_A(h)$ in output-grounded causal usefulness. (c) FALI attributes this endpoint change under an explicit intervention game across task-target scores ($T$), rival scores ($R$), other structurally valid scores ($O$), value content ($V$), and surrounding-network context ($C$), with Owen efficiency $\phi _T+\phi _R+\phi _O+\phi _V+\phi _C=\Delta _h$. The candidate head and task-relevant target coordinates are specified before FALI analysis.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:fali-overview}{{1}{8}{\textbf {FALI resolves a conditional change in a selected attention head's causal usefulness.} (a) The same candidate head $h$ is evaluated in an intact state $A$ and a prespecified perturbed state $B$. (b) The quantity to be explained is the cross-state change $\Delta _h=E_B(h)-E_A(h)$ in output-grounded causal usefulness. (c) FALI attributes this endpoint change under an explicit intervention game across task-target scores ($T$), rival scores ($R$), other structurally valid scores ($O$), value content ($V$), and surrounding-network context ($C$), with Owen efficiency $\phi _T+\phi _R+\phi _O+\phi _V+\phi _C=\Delta _h$. The candidate head and task-relevant target coordinates are specified before FALI analysis}{figure.1}{}}
